# Backend: Daisugi (Nethermind). A DISTINCT client and testnet, not a frozen
# standard and not interoperable with ethrex Hegota. Daisugi uses LeanSPHINCS
# (hash-based) signatures aggregated off-chain via a DEP_VERIFY (mode 0x4) frame,
# a different envelope, and chainId 1337.
#
# This backend ships its OWN dialect PoCs (a Node signer+codec in pocs/) rather
# than reusing the ethrex core PoCs. run.sh picks the Node runner via RUNNER below.
# Run ./backends/daisugi/setup.sh once before ./run.sh daisugi.
export PQ_RPC_URL=https://daisugi.fyi/rpc
export PQ_CHAIN_ID=1337
export PQ_FAUCET_URL=https://daisugi.fyi/api/faucet

# Daisugi contract pins (Gen2 aggregated-frame account). Verify against the RPC
# before trusting a build; this testnet may re-genesis.
export DAISUGI_FACTORY=0x4940E0D0883fa40985fEC192FdD9E11C7A34d9D0
export DAISUGI_IMPLEMENTATION=0x016d1A8326E714552F6517177DB55eD45a5CB6E8

# Dialect runner: Node PoCs in this backend's own pocs/ directory.
export RUNNER=node
export POCS_DIR="$HERE/backends/daisugi/pocs"
export DEFAULT_POCS="poc_submit.mjs"
