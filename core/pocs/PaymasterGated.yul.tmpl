// EIP-8141 frame-native PAYMASTER, gated, STORAGE-FREE (ethrex Hegota dialect).
//
// Same role as Paymaster.yul (approve PAYMENT in its own VERIFY frame so payer =
// frame.target = this paymaster, no payer==sender check), but it does NOT read storage.
//
// WHY no storage: VERIFY frames run in the validation prefix, which ethrex restricts
// like ERC-4337 account/paymaster validation: a frame may not read the storage of an
// account that is not the tx sender. The paymaster is NOT the sender, so any SLOAD of
// its own slots is rejected at submission with "StorageReadNonSender" (verified
// on-chain). So the operator address is baked into the CODE as an immutable constant
// (substituted at build time), not kept in storage. ecrecover and SIGDATACOPY touch tx
// parameters, not account storage, so they are allowed in the prefix.
//
// Gate: approves payment ONLY IF an operator ECDSA signature over this exact canonical
// sig_hash ecrecovers to the baked operator. Wrong / missing signature -> revert -> the
// VERIFY frame never calls APPROVE -> ethrex rejects the whole tx in the validation
// prefix, so the paymaster balance is never burned on an unauthorized transaction.
//
// The operator signature travels inline in signature entry index 1 (65 bytes r||s||v,
// v = 27/28). Signature entry 0 carries the account's ML-DSA.
//
// NOTE: Yul `verbatim` places the FIRST argument on TOP of the stack.
object "PaymasterGated" {
    code {
        // No constructor storage; the operator is a code constant. Just return runtime.
        let sz := datasize("runtime")
        datacopy(0, dataoffset("runtime"), sz)
        return(0, sz)
    }
    object "runtime" {
        code {
            let operator := 0x000000000000000000000000__OPERATOR__   // baked at build time

            let sigHash := verbatim_1i_1o(hex"b0", 0x08)   // TXPARAM(sig_hash)

            // Operator signature: 65 bytes r||s||v, inline in signature entry index 1.
            verbatim_4i_0o(hex"b5", 128, 0, 65, 1)         // SIGDATACOPY -> mem[128..193]
            let r := mload(128)
            let s := mload(160)
            let v := byte(0, mload(192))

            mstore(0, sigHash)
            mstore(32, v)
            mstore(64, r)
            mstore(96, s)
            let ok := staticcall(gas(), 0x01, 0, 128, 200, 32)   // ecrecover
            if iszero(ok) { revert(0, 0) }
            if iszero(eq(mload(200), operator)) { revert(0, 0) }  // must be the operator

            verbatim_3i_0o(hex"aa", 0, 0, 1)               // APPROVE(0, 0, scope=1=PAYMENT)
            stop()
        }
    }
}
